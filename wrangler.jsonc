{
  "name": "custix-ai",
  // custom-worker.ts reicht den OpenNext-Handler (.open-next/worker.js) durch
  // und ergänzt `scheduled` für die Cron Trigger unten (ADR-0014).
  "main": "./custom-worker.ts",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://custix.ai",
    "BETTER_AUTH_URL": "https://custix.ai",
    // NEXT_PUBLIC_GA4_ID gehört NICHT hierher: als Laufzeitvariable erreicht
    // sie das Client-Bundle nicht. Sie steht in next.config.ts unter `env`.
    // Stripe-Preis-IDs (keine Geheimnisse). Aus dem Stripe-Dashboard eintragen.
    "STRIPE_PRICE_MONTHLY": "",
    "STRIPE_PRICE_ANNUAL": "",
    // Turnstile-Widget für Partner-Formulare (ADR-0011) – der Site-Key ist
    // öffentlich; das Geheimnis kommt per `wrangler secret put TURNSTILE_SECRET_KEY`.
    // Leer == Partner-Formulare zeigen „derzeit nicht verfügbar“.
    // Widget „custix Partner-Formulare“, Hostnamen: finditoo-marketing.com,
    // www.finditoo-marketing.com (Cloudflare → Turnstile).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFK6FLkUWT2GKUGX"
  },
  // Ratenbegrenzung für Partner signups pro IP (ADR-0011).
  // period erlaubt nur 10 oder 60 Sekunden.
  "ratelimits": [
    {
      "name": "PARTNER_SIGNUP_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 5, "period": 60 }
    },
    // Registrierung „E-Mail zuerst“ (#15, ADR-0013): /api/signup/start schickt
    // eine Mail an eine frei eingegebene Adresse. Pro IP (eine Kanzlei hinter
    // einem Anschluss) und pro Adresse („Erneut senden“ einmal pro Minute).
    {
      "name": "SIGNUP_IP_LIMITER",
      "namespace_id": "1012",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SIGNUP_EMAIL_LIMITER",
      "namespace_id": "1013",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "custix-db",
      "database_id": "e605d463-7fcf-43ca-b027-3f99322e5a48",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "custix-models"
    },
    // Feedback-Screenshots (mrgoofman/custix-ai#16, ADR-0014). Privat: kein
    // öffentlicher Zugang, keine r2.dev-URL; ausgeliefert nur über
    // /api/feedback/screenshot/<id> an Eigentümer und Admins.
    // Anlegen (einmalig): `npx wrangler r2 bucket create custix-feedback`.
    {
      "binding": "FEEDBACK",
      "bucket_name": "custix-feedback"
    }
  ],
  // Täglich 03:17 UTC: Feedback-Screenshots älter als 90 Tage löschen
  // (scheduled-Handler in custom-worker.ts, ADR-0014).
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
