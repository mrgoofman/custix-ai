{
  "name": "custix-ai",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://custix.ai",
    "BETTER_AUTH_URL": "https://custix.ai"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "custix-db",
      "database_id": "e605d463-7fcf-43ca-b027-3f99322e5a48",
      "migrations_dir": "migrations"
    }
  ]
}
